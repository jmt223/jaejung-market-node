# Rocky Linux 서버용 설정 예시. 이거 복사해서 .env 만들고 값 채우기
# 백엔드는 같은 서버의 프론트(Next)만 부르니까 127.0.0.1:4000 으로만 뜸
PORT=4000

# DB 서버 (스프링이랑 같은 sampledb 씀)
DB_HOST=192.168.100.30
DB_PORT=3306
DB_USERNAME=springuser
DB_PASSWORD=
DB_DATABASE=sampledb
DB_TIMEZONE=+09:00

# JWT 서명 키. 32자 이상 랜덤값 필수
# 만드는법 : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# HTTPS로 서비스하면 true (쿠키 Secure 속성)
COOKIE_SECURE=false

# 이미지 저장 폴더. 웹 루트 밖이어야 함
UPLOAD_DIR=/opt/jmt223-node/uploads

# 관리자 페이지 접속 허용 IP (쉼표 구분). 비워두면 전부 404
ADMIN_ALLOWED_IPS=
